{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { npx tsc --noEmit -p tsconfig.json 2>&1 | head -10; npx tsc --noEmit -p tsconfig.electron.json 2>&1 | head -10; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "if grep -qE '(package-lock\\.json|resources/icon)'; then echo 'BLOCKED: This file is protected. Edit manually if needed.' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx electron *)",
      "Bash(npx electron-builder *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(node *)"
    ]
  }
}
